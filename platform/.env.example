# Copy to .env.local (git-ignored). Never commit secrets.
NEXT_REVALIDATE_SECRET=your-secret-token-here

NODE_ENV=development

# Postgres (see infra/docker-compose.yml)
DATABASE_URL=postgresql://barbershop:barbershop@localhost:15432/barbershop

# Redis (realtime + jobs)
REDIS_URL=redis://localhost:16379

# Object storage (S3-compatible) — MinIO в docker-compose (ADR 0008/0015)
# Apps on host (mobile, local scripts) hit localhost; containers use infra/.env.docker
S3_ENDPOINT=http://localhost:19000
S3_PUBLIC_URL=http://localhost:19000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_BUCKET_AI=haircut-ai-photos
S3_BUCKET_FEEDBACK=feedback-photos
S3_BUCKET_MEDIA=media

# MinIO веб-консоль (dev): http://localhost:19001

# API
API_PORT=13000
API_PUBLIC_URL=http://localhost:13000

# Session cookie (ADR 0017, T-4614d). Dev and prod default to the prod domains.
# Prod client: .fade.com.ua. Prod admin: admin.fade.com.ua.
# Stage (NODE_ENV=stage) must set both to empty — host-only, no Domain attribute.
# A missing or prod value makes the API refuse to start, so stage cannot share a session with fade.com.ua.
# FADE_CLIENT_DOMAIN=
# FADE_ADMIN_DOMAIN=
# COOKIE_SECURE=true

# CORS — explicit allowlist for browser callers (no wildcard; session cookie needs credentials: true)
# Prod: https://fade.com.ua (site + /booking), https://admin.fade.com.ua (+ shop later) — ADR 0017
CORS_ALLOWED_ORIGINS=http://localhost:13001,http://localhost:13002

# Public web
WEB_URL=http://localhost:13001

# Admin
ADMIN_URL=http://localhost:13002

# Mobile (Expo) Metro bundler — not containerized, runs on host (ADR 0018 §2)
# Metro: http://localhost:18081 (EXPO_METRO_PORT)

# Auth — client phone OTP (ADR 0005)
JWT_SECRET=change-me
# console — код у логах api; mailpit — лист на <phone>@sms.dev у http://localhost:19096
OTP_PROVIDER=mailpit
MAILPIT_URL=http://localhost:19096
OTP_TTL_SECONDS=300
SMS_PROVIDER=
SMS_API_KEY=

# Push (Expo)
EXPO_ACCESS_TOKEN=

# Fiscalization — Checkbox (ACL, later)
CHECKBOX_API_URL=
CHECKBOX_LICENSE_KEY=

# Acquiring (ACL, later)
ACQUIRING_PROVIDER=none

# Legacy CRM during transition (optional ACL)
ALTEGIO_API_URL=
ALTEGIO_API_KEY=

# Dev stack: docker compose -f development/platform/infra/docker-compose.yml \
#   --env-file development/platform/infra/.env.docker --profile deps up -d   # deps only
#   --env-file development/platform/infra/.env.docker --profile apps up -d   # + api/web/admin
