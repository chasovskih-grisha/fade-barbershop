{
  "expo": {
    "name": "FADE",
    "slug": "barbershop",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F11"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barbershop.app",
      "userInterfaceStyle": "dark"
    },
    "android": {
      "package": "com.barbershop.app",
      "userInterfaceStyle": "dark"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Галерея потрібна, щоб прикріпити фото-референс зачіски до візиту.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
