{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "jsx": "react-native",
    "allowJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "paths": {
      "@/*": ["./src/*"],
      "@fade/contracts": ["../../packages/contracts/src"],
      "@fade/domain-shared": ["../../packages/domain-shared/src"]
    }
  },
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../packages/domain-shared" }
  ],
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
