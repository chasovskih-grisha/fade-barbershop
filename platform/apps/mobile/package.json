{
  "name": "@fade/mobile",
  "private": true,
  "version": "0.0.0",
  "description": "Expo app for clients and barbers",
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_USE_METRO_WORKSPACE_ROOT=1 NODE_OPTIONS=\"--require ./scripts/image-size-compat.cjs\" expo start --port 18081",
    "dev": "EXPO_USE_METRO_WORKSPACE_ROOT=1 NODE_OPTIONS=\"--require ./scripts/image-size-compat.cjs\" expo start --port 18081",
    "android": "EXPO_USE_METRO_WORKSPACE_ROOT=1 NODE_OPTIONS=\"--require ./scripts/image-size-compat.cjs\" expo start --port 18081 --android",
    "ios": "EXPO_USE_METRO_WORKSPACE_ROOT=1 NODE_OPTIONS=\"--require ./scripts/image-size-compat.cjs\" expo start --port 18081 --ios",
    "web": "EXPO_USE_METRO_WORKSPACE_ROOT=1 NODE_OPTIONS=\"--require ./scripts/image-size-compat.cjs\" expo start --port 18081 --web",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo/metro-runtime": "~3.1.3",
    "@fade/design-tokens": "workspace:*",
    "expo": "~50.0.0",
    "expo-asset": "~9.0.2",
    "expo-constants": "~15.4.5",
    "expo-image-picker": "~14.7.1",
    "expo-notifications": "~0.27.8",
    "expo-router": "~3.4.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.0",
    "react-native-safe-area-context": "4.8.2",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.2",
    "@types/react": "^18.2.0",
    "eslint": "^8.42.0",
    "jest": "^29.5.0",
    "jest-expo": "~50.0.0",
    "typescript": "^5.1.3"
  }
}
