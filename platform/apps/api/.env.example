# Локальна dev-БД — Postgres з infra/docker-compose.yml (профіль deps).
# Хост-порт 15432 (loopback). Всередині контейнера API порт інший (5432) — див. docker-compose.yml.
DATABASE_URL="postgresql://barbershop:barbershop@127.0.0.1:15432/barbershop"

# CORS origin for frontend (dev default: http://localhost:13001)
CORS_ORIGIN="http://localhost:13001"

# OTP у SMSPitt (Web UI http://localhost:19096). console — код лише в логах api.
OTP_PROVIDER=mailpit
MAILPIT_URL=http://localhost:19096

# Email-сповіщення (T-4608): консьюмер outbox шле лист підтвердження запису
# через EmailSender (T-4408). mailpit — Web UI http://localhost:19096.
EMAIL_PROVIDER=mailpit
# Поллер outbox у notifications: інтервал опитування своїх подій (мс; 0 — вимкнути).
NOTIFICATIONS_OUTBOX_POLL_MS=15000

# OpenTelemetry tracing (T-4204f): OTLP/HTTP на колектор obs-профілю.
# Без змінної SDK живий, але нічого не експортує (локальний dev без obs).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SDK_LOG_LEVEL=debug  — діагностика SDK у stdout

# Rate limits (dev: high limits for localhost, prod/stage: normal limits)
# OTP request: max requests per window (default: 1000 in dev, 5 in prod/stage)
RATE_LIMIT_OTP_REQUEST_MAX=1000
# OTP request: window in milliseconds (default: 1 hour = 3600000)
RATE_LIMIT_OTP_REQUEST_WINDOW_MS=3600000
# OTP verify: max requests per window (default: 1000 in dev, 10 in prod/stage)
RATE_LIMIT_OTP_VERIFY_MAX=1000
# OTP verify: window in milliseconds (default: 1 hour = 3600000)
RATE_LIMIT_OTP_VERIFY_WINDOW_MS=3600000
# Admin login (username+password brute-force): dev default 10/h (close to prod), prod 5/h
RATE_LIMIT_ADMIN_LOGIN_MAX=10
# Admin login: window in milliseconds (default: 1 hour = 3600000)
RATE_LIMIT_ADMIN_LOGIN_WINDOW_MS=3600000

# Haircut AI (ADR 0008). У CI і тестах лишається fake — ключ туди не класти.
# AI_PROVIDER=fake
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image