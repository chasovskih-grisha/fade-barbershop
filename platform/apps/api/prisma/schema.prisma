generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Модель User — role 'client' за замовчуванням, name nullable, admin/barber-поля
// (username/passwordHash/selfSchedule).
model User {
  id              String       @id @db.Uuid
  phone           String       @unique
  role            String       @default("client")
  name            String?
  // T-4422: email для сповіщень безпеки (вхід — за ADR 0005, лише телефон).
  email           String?      @unique
  active          Boolean      @default(true)
  selfSchedule    Boolean      @default(false)
  username        String?      @unique
  passwordHash    String?
  phoneVerifiedAt DateTime?    @db.Timestamptz
  createdAt       DateTime     @default(now()) @db.Timestamptz
  updatedAt       DateTime     @updatedAt @db.Timestamptz
  barberPhoto     BarberPhoto?

  @@index([role, active])
}

// AdminRole — підролі адмінки (T-2400a, ADR 0027): super-admin | manager |
// barber. `permissions` — масив секцій (`*` — усі); `priority` — широта прав.
// Кіт початкових ролей у коді (identity/domain/admin-role.ts), не в рантаймі.
model AdminRole {
  id          String   @id @db.Uuid
  key         String   @unique
  name        String
  description String
  permissions String[]
  priority    Int
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@index([priority])
}

// Модель OtpChallenge — хеш коду (codeHash), а не код; throttle-поля.
// AppSetting — адмін-налаштування платформи (MNG-ADM-18): ключ → JSON-значення.
// Інтеграції змінюються без деплою; читають їх контекст-специфічні адаптери
// (наприклад, PrismaGeocoderSettings у locations — вибір провайдера геокодування).
model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

// DepositPolicyVersion — історія правил депозиту (T-4444, PAY-ADM-09).
// Кожна зміна %/округлення/вікна пише новий рядок із монотонною версією;
// клієнт погоджується з версією, чинною на момент запису. Поточна версія
// лежить в AppSetting (`billing.depositPolicy`), історія — тут.
model DepositPolicyVersion {
  id                      String   @id @db.Uuid
  version                 Int      @unique
  percent                 Int
  rounding                Int
  cancellationWindowHours Int
  createdBy               String?  @db.Uuid
  createdAt               DateTime @default(now()) @db.Timestamptz

  @@index([createdAt])
}

model OtpChallenge {
  id          String    @id @db.Uuid
  phone       String
  codeHash    String
  purpose     String    @default("login")
  expiresAt   DateTime  @db.Timestamptz
  resendAfter DateTime  @db.Timestamptz
  attempts    Int       @default(0)
  lockedUntil DateTime? @db.Timestamptz
  usedAt      DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@index([phone, expiresAt, purpose])
}

// Модель Session — channel + tokenHash + revokedAt.
// T-014 (канал mobile): refreshTokenHash — хеш поточного refresh (unique —
// CAS-ротація updateMany where), accessExpiresAt — життя access-токена.
model Session {
  id                  String    @id @db.Uuid
  userId              String    @db.Uuid
  channel             String
  tokenHash           String    @unique
  refreshTokenHash    String?   @unique
  previousRefreshHash String?
  accessExpiresAt     DateTime? @db.Timestamptz
  refreshExpiresAt    DateTime? @db.Timestamptz
  createdAt           DateTime  @default(now()) @db.Timestamptz
  revokedAt           DateTime?

  @@index([previousRefreshHash])
  @@index([userId])
  @@index([userId, revokedAt])
}

// PushToken — канал сповіщень пристрою (T-070 мобільний / T-4422 безпека).
// Токен Expo унікальний; прив'язаний до sessionId, тож «пуш на інші пристрої»
// = токени інших активних сесій, а revoke сесії глушить її канал. Немає рядка —
// канал «не дозволений» (дозвіл дає ОС, окремого прапорця згоди не тримаємо).
model PushToken {
  id         String    @id @db.Uuid
  userId     String    @db.Uuid
  sessionId  String    @db.Uuid
  token      String    @unique
  platform   String    @default("ios")
  createdAt  DateTime  @default(now()) @db.Timestamptz
  lastSeenAt DateTime  @default(now()) @db.Timestamptz
  revokedAt  DateTime? @db.Timestamptz

  @@index([userId, revokedAt])
}

// Модель OutboxMessage — без attempts/occurredAt; публікація = publishedAt.
// availableAt (T-080) — відкладена доставка: рядок нагадування
// «notification.reminder.due» лежить тут до часу спрацювання, а релей
// бачить його лише після availableAt; null = «доставти негайно».
model OutboxMessage {
  id            String    @id @db.Uuid
  aggregateType String
  aggregateId   String
  type          String
  payload       Json
  status        String    @default("pending")
  createdAt     DateTime  @default(now()) @db.Timestamptz
  availableAt   DateTime? @db.Timestamptz
  publishedAt   DateTime? @db.Timestamptz

  @@index([type, publishedAt, availableAt])
  @@index([aggregateId])
  @@index([publishedAt])
  @@index([status, availableAt])
}

// Журнал оброблених подій (T-042c, патерн ADR 0009): eventId унікальний —
// повторна доставка outbox не дублює ефектів обробника-еталона.
model AppointmentActivity {
  id          String   @id @db.Uuid
  eventId     String   @unique
  type        String
  note        String?
  processedAt DateTime @default(now()) @db.Timestamptz

  @@index([type, processedAt])
}

// Сповіщення (notifications, T-4608): журнал email за подіями outbox.
// eventId унікальний — повторна доставка не дублює листа. Успіх = рядок
// 'sent' ПІСЛЯ відправки; 'skipped' (немає одержувача) — теж у журналі;
// 'failed' НЕ пишеться — падіння send лишає подію pending, і повторна
// доставка має право на нову спробу (ретрай через at-least-once).
model NotificationRecord {
  id        String   @id @db.Uuid
  eventId   String   @unique
  type      String
  channel   String   @default("email")
  recipient String
  subject   String
  status    String   @default("sent")
  detail    String?
  sentAt    DateTime @default(now()) @db.Timestamptz

  @@index([type, sentAt])
  @@index([status, sentAt])
  @@index([recipient])
}

model ClientNotificationPreference {
  id             String   @id @db.Uuid
  clientId       String   @unique @db.Uuid
  smsEnabled     Boolean  @default(true)
  emailEnabled   Boolean  @default(true)
  pushEnabled    Boolean  @default(true)
  loyaltyOptOut  Boolean  @default(false)
  reminderOptOut Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
}

model AppointmentParty {
  id            String    @id @db.Uuid
  role          String
  userId        String?   @db.Uuid
  barberId      String?   @db.Uuid
  locationId    String?   @db.Uuid
  date          DateTime? @db.Timestamptz
  mode          String?
  barberIds     String[]  @default([]) @db.Uuid
  serviceId     String?   @db.Uuid
  agreedPriceId String?   @db.Uuid
  agreedPrice   Int?
  slots         Json?
  partyLegs     Json?
  createdAt     DateTime  @default(now()) @db.Timestamptz

  @@index([date])
  @@index([locationId])
  @@index([barberId])
  @@index([userId])
  @@index([locationId, date])
  @@index([barberId, date])
  @@index([userId, date])
}

// Модель Location — code/lat/lng/email. slug/latitude/longitude у БД не існують
// (назва-попередження після дрейфу міграцій 2026-09-22/23, сквошованих в 0_init).
model Location {
  id         String   @id @db.Uuid
  code       String   @unique
  name       String
  address    String
  // Структурована адреса (T-4405). Nullable — expand-фаза: legacy-рядки
  // зберігають повний текст у `address`, адмін підтверджує структуру в UI.
  street     String?
  building   String?
  city       String?
  postalCode String?
  country    String?
  lat        Float
  lng        Float
  phone      String?
  email      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  chairs        Chair[]
  hours         OpeningHour[]
  channels      LocationChannel[]
  photos        LocationPhoto[]
  logo          LocationLogo?
  servicePrices ServicePrice[]
  stockItems    StockItem[]

  @@index([active])
}

// Логотип локації (T-4609a): знак ідентичності точки, не галерея. Ключі
// об'єктів у публічному бакеті location-brand; публічні URL рахуються з них.
model LocationLogo {
  id         String   @id @db.Uuid
  locationId String   @unique @db.Uuid
  variant    String
  lightKey   String
  darkKey    String?
  alt        String
  updatedAt  DateTime @updatedAt @db.Timestamptz
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

// Фото барбера (T-4610a): персональні дані з обов'язковою згодою (ADR 0015).
model BarberPhoto {
  id        String    @id @db.Uuid
  userId    String    @unique @db.Uuid
  objectKey String
  alt       String
  width     Int?
  height    Int?
  consentAt DateTime? @db.Timestamptz
  consentBy String?
  updatedAt DateTime  @updatedAt @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Chair {
  id         String   @id @db.Uuid
  number     Int
  locationId String   @db.Uuid
  name       String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz
  location   Location @relation(fields: [locationId], references: [id])

  @@unique([locationId, number])
  @@index([locationId, active])
}

model OpeningHour {
  id         String   @id @db.Uuid
  locationId String   @db.Uuid
  dayOfWeek  Int
  open       String?
  close      String?
  closed     Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz
  location   Location @relation(fields: [locationId], references: [id])

  @@unique([locationId, dayOfWeek])
}

// Канали зв'язку локації (MNG-ADM-01: телефон/email; розширення — viber,
// telegram, instagram тощо). Значення валідує домен; один канал на тип.
model LocationChannel {
  id         String   @id @db.Uuid
  locationId String   @db.Uuid
  channel    String
  value      String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz
  location   Location @relation(fields: [locationId], references: [id])

  @@unique([locationId, channel])
}

// Фото галереї сторінки локації (web-screens §2). Публічні URL — лише
// опубліковані модератором елементи; сирі фото клієнтів живуть у portfolio.
model LocationPhoto {
  id         String   @id @db.Uuid
  locationId String   @db.Uuid
  url        String
  caption    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz
  location   Location @relation(fields: [locationId], references: [id])

  @@index([locationId, sortOrder])
}

model AvailabilityWindow {
  id         String   @id @db.Uuid
  locationId String   @db.Uuid
  barberId   String   @db.Uuid
  dayOfWeek  Int
  start      String
  end        String
  createdAt  DateTime @default(now()) @db.Timestamptz
  version    Int      @default(0)

  @@unique([barberId, locationId, dayOfWeek, start, end])
  @@index([locationId])
}

model StaffAssignment {
  id         String   @id @db.Uuid
  barberId   String   @db.Uuid
  locationId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@unique([barberId, locationId])
  @@index([locationId])
}

model Booking {
  id                      String   @id @db.Uuid
  barberId                String   @db.Uuid
  locationId              String   @db.Uuid
  serviceId               String?  @db.Uuid
  agreedPrice             Int?
  // Снепшот ціни (T-090, ADR 0006/0007): appliedDiscounts — знижки, застосовані
  // при записі; finalPrice — підсумок (≥ 0, DSC-004). Зміна каталогу/правил не
  // рухає наявні записи.
  appliedDiscounts        Json?
  finalPrice              Int?
  agreedDuration          Int? // T-4618a: agreed duration snapshot in minutes
  fulfillmentMode         String?
  partyId                 String?  @db.Uuid
  partyRole               String?
  start                   DateTime @db.Timestamptz
  end                     DateTime @db.Timestamptz
  version                 Int      @default(0)
  // Життєвий цикл Appointment (T-042a): агрегат живе на рядку бронювання.
  appointmentId           String?  @unique
  status                  String?
  cancelReason            String?
  // Референс зачіски + коментар (T-043): лише ID референса (haircut-ai або
  // зовнішній upload — інваріант bounded-contexts), коментар — plain text ≤500.
  haircutReferenceId      String?
  appointmentComment      String?
  // Джерело бронювання (T-046, ANL-004): канал запису; клієнт — посилання на identity/CRM.
  clientId                String?  @db.Uuid
  source                  String   @default("web")
  // Снепшот surge (T-4811): множник і правило, за яким він застосований.
  surgeBasisPoints        Int?
  surgeRuleId             String?  @db.Uuid
  // Снепшот умов депозиту (PAY-ADM-09): % і округлення фіксуються при записі,
  // вікно скасування теж; дедлайн кабінет рахує від start, тож перенесення
  // візиту не лишає простроченого снепшота. NULL — грошей у візиті немає.
  depositAmount           Int?
  depositPercent          Int?
  depositRounding         Int?
  cancellationWindowHours Int?

  @@index([locationId, start, end])
  @@index([barberId, start, end])
  @@index([clientId])
  @@index([clientId, status])
  @@index([status])
  @@index([serviceId])
  @@index([locationId, status])
  @@index([barberId, status])
  @@index([partyId])
  @@index([haircutReferenceId])
}

model Service {
  id               String         @id @db.Uuid
  name             String
  description      String?
  category         String?
  slug             String?        @unique
  seoDescription   String?
  faq              Json?
  duration         Int
  parallelDuration Int?
  active           Boolean        @default(true)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now()) @db.Timestamptz
  updatedAt        DateTime       @updatedAt @db.Timestamptz
  prices           ServicePrice[]
  isAddon          Boolean        @default(false)
  packageItems     String[]       @default([])
  cleanupMinutes   Int            @default(0)
  resourceIds      String[]       @default([])
  commissionPercent Int?          @default(null)
  consumableItems  String[]       @default([])

  @@unique([name, duration, isAddon])
  @@index([active, isAddon])
}

model ServicePrice {
  id         String   @id @db.Uuid
  serviceId  String   @db.Uuid
  locationId String   @db.Uuid
  amount     Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locationId])
  @@index([locationId, active])
}

// BarberServiceAssignment — матриця «який барбер обслуговує які послуги» (T-4522).
// Дефолтна одиниця вибору при створенні візиту через нові випадаючі списки:
// клієнт обирає локацію → послугу → барбера (T-4521 матриця + T-4522 слот-політика).
// Сервіс без жодного завівального барбера в локації не потрапить у /booking/slots як
// обраний (available barberCandidates після фільтру матриці=0 → слот disabled).
// Заставою для кросплатформного кешування політик: запис тут інкрементально змінюється
// адміном, а не переписується кожен раз при генерації слотів.
model BarberServiceAssignment {
  id         String   @id @db.Uuid
  barberId   String   @db.Uuid
  locationId String   @db.Uuid
  serviceId  String   @db.Uuid
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@unique([barberId, locationId, serviceId])
  @@index([locationId, serviceId, active])
  @@index([locationId, active])
  @@index([barberId, active])
  @@index([serviceId, active])
}

// Доменна модель матриці — не ORM-ліving, лише для адмін-керування через репозиторій.
// Застава: матриця кешується в слот-генерацію як фільтр кандидатів барбера для обраної
// послуги в локації; без рядка — барбер-плейсхолдер "Будь-який барбер" (T-4521).

// SurgeRule (T-4811) — множники ціни за годиною/днем/рівнем барбера.
// locationId = null — мережеве правило; множник у базисних пунктах (12500 = ×1.25).
model SurgeRule {
  id            String   @id @db.Uuid
  locationId    String?  @db.Uuid
  dayOfWeek     Int?
  fromMinute    Int?
  toMinute      Int?
  seniorityTier String?
  multiplierBp  Int      @default(10000)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  @@index([locationId, active])
}

// OnlineBookingPolicy (T-4542) — обмеження онлайн-букінгу на локацію;
// locationId = null — глобальний дефолт (єдиний рядок). Значення читаються
// EvaluateOnlineBooking і віддаються фронту через GET /booking/policy.
model OnlineBookingPolicy {
  id                         String   @id @db.Uuid
  locationId                 String?  @unique @db.Uuid
  minLeadMinutes             Int      @default(60)
  maxHorizonDays             Int      @default(30)
  cancellationDeadlineHours  Int      @default(12)
  rescheduleDeadlineHours    Int      @default(12)
  maxActiveBookings          Int      @default(2)
  allowGuestBooking          Boolean  @default(true)
  blockNoShowsCount          Int      @default(3)
  blockNoShowsWindowDays     Int      @default(180)
  createdAt                  DateTime @default(now()) @db.Timestamptz
  updatedAt                  DateTime @updatedAt @db.Timestamptz
}

// LocationSlotPolicy — налаштування генерації слотів на рівні локації (T-4522).
// Сховище політик, які зараз захардкожені в SlotValidator / available-slots.ts:
// крок сітки (stepMinutes, дефолт 15), буфер між записами (bufferMinutes, дефолт 0),
// горизонт запису (horizonDays, дефолт 14) і поріг «останньої хвилини»
// (lastMinuteMinutes, дефолт 60) — скільки хвилин до початку слот закривається для
// нового запису. Дефолти використовуються, коли рядка в БД ще немає (снепшот при
// генерації, як політика депозиту в PAY-ADM-09).
// Валідація діапазонів Т-4522.Done(1) — адмін-UI не приймає hex, лише slices
// (number 5/10/15 для step, 0..60 для buffer, 1..30 для horizon, 0..120 для lastMinute).
model LocationSlotPolicy {
  id                String   @id @db.Uuid
  locationId        String   @unique @db.Uuid
  stepMinutes       Int      @default(15)
  bufferMinutes     Int      @default(0)
  horizonDays       Int      @default(14)
  lastMinuteMinutes Int      @default(60)
  timeZone          String   @default("Europe/Kyiv")
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @updatedAt @db.Timestamptz
}

model CatalogAudit {
  id         String   @id @db.Uuid
  actorId    String   @db.Uuid
  objectType String
  objectId   String
  before     Json?
  after      Json
  changedAt  DateTime @default(now()) @db.Timestamptz

  @@index([objectType, objectId, changedAt])
  @@index([actorId, changedAt])
}

// Article — публікація блогу (context content, T-031/MNG-ADM-17). Чернетка чи
// published; slug — SEO-URL сторінки (унікальний). Теги — масив рядків.
model Article {
  id          String    @id @db.Uuid
  slug        String    @unique
  title       String
  excerpt     String?
  body        String
  coverUrl    String?
  authorName  String?
  tags        String[]  @default([])
  status      String    @default("draft")
  publishedAt DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  @@index([status, publishedAt])
  @@index([createdAt])
}

model SeoBlockRecord {
  id              String   @id @db.Uuid
  entityType      String
  entityId        String
  title           String?
  metaDescription String?
  h1              String?
  faq             Json     @default("[]")
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  @@unique([entityType, entityId])
  @@index([entityType])
}

model ClientProfile {
  id                 String   @id @db.Uuid
  userId             String   @unique @db.Uuid
  name               String?
  phone              String   @unique
  // День народження (T-4730): лише день і місяць, без року. Порожнє — дефолт.
  birthDay           Int?
  birthMonth         Int?
  preferences        Json     @default("[]")
  notes              Json     @default("[]")
  vipDiscountPercent Int?
  loyaltyVisitsCount Int      @default(0)
  createdAt          DateTime @default(now()) @db.Timestamptz
  updatedAt          DateTime @updatedAt @db.Timestamptz

  @@index([createdAt])
}

// Visit — read-model історії візитів клієнта (crm, T-061). Проєкція подій
// scheduling; ключ appointmentId робить запис ідемпотентним (повторна
// доставка — upsert, не дубль). occurredAt — час останньої події: guard від
// регресу при redelivery. Дата слота живе на Booking, тут — лише `HH:mm`.
model Visit {
  appointmentId String   @id @db.Uuid
  clientId      String   @db.Uuid
  barberId      String?  @db.Uuid
  locationId    String?  @db.Uuid
  status        String
  start         String?
  end           String?
  occurredAt    DateTime @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  @@index([clientId, occurredAt])
  @@index([barberId, occurredAt])
}

// SourcePhoto — референсне фото клієнта (context haircut-ai, ADR 0008). Байти
// живуть у НАШОМУ приватному бакете; тут лише метадані + згода на AI-обробку
// (AI-WEB-02). Згода НЕ виводиться з факту завантаження — окремий крок.
// deletedAt — soft-delete: об'єкти з бакета чистить ретеншен-воркер (AI-ADM-06).
model SourcePhoto {
  id               String    @id @db.Uuid
  ownerId          String    @db.Uuid
  objectKey        String    @unique
  bucket           String
  contentType      String
  sizeBytes        Int
  consentGranted   Boolean   @default(false)
  consentGrantedAt DateTime? @db.Timestamptz
  consentRevokedAt DateTime? @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt @db.Timestamptz
  deletedAt        DateTime? @db.Timestamptz

  suggestions HaircutSuggestion[]

  @@index([ownerId, deletedAt])
  @@index([ownerId, createdAt])
}

// HaircutSuggestion — одна AI-генерація варіантів (T-050). Статус-машина
// pending|processing|ready|failed; ready/failed — термінальні. variants — JSON
// [{objectKey, contentType}] (ADR 0008: ре-хостимо в наш бакет, клієнт бачить
// лише підписані URL). providerJobHandle — opaque ідентифікатор провайдера.
model HaircutSuggestion {
  id                String    @id @db.Uuid
  sourcePhotoId     String    @db.Uuid
  ownerId           String    @db.Uuid
  status            String    @default("pending")
  variantCount      Int
  variants          Json      @default("[]")
  failureReason     String?
  errorMessage      String?
  providerJobHandle String?   @unique
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz
  completedAt       DateTime? @db.Timestamptz
  failedAt          DateTime? @db.Timestamptz

  sourcePhoto SourcePhoto @relation(fields: [sourcePhotoId], references: [id], onDelete: Cascade)

  @@index([sourcePhotoId])
  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@index([ownerId, status])
}

// ArchiveRun (T-4804) — аудит холодного архівування бронювань: cutoff, скільки
// рядків вивантажено/лишилось, ключі об'єктів і їхні SHA-256.
model ArchiveRun {
  id        String   @id @db.Uuid
  cutoff    DateTime @db.Timestamptz
  archived  Int
  remaining Int      @default(0)
  keys      Json
  checksums Json
  ranAt     DateTime @default(now()) @db.Timestamptz

  @@index([ranAt])
}

// RetentionPurge (T-4490) — аудит проходів політики утримання: який набір,
// за яким cutoff, скільки видалено і чи лишились прострочені рядки.
model RetentionPurge {
  id               String   @id @db.Uuid
  dataset          String
  cutoff           DateTime @db.Timestamptz
  purged           Int
  remainingExpired Int      @default(0)
  held             Boolean  @default(false)
  ranAt            DateTime @default(now()) @db.Timestamptz

  @@index([ranAt])
}

// AmplitudeOutbox (T-4587) — серверна черга подій Amplitude. sourceEventId —
// id доменної події з OutboxMessage (унікальний: повторний перенос
// ідемпотентний). payload — готовий AmplitudeEvent (insert_id для дедупку з
// клієнтом). status: pending | sent | dead_letter.
model AmplitudeOutbox {
  id            String    @id @db.Uuid
  sourceEventId String    @unique @db.Uuid
  eventName     String
  insertId      String
  payload       Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz
  lastError     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz
  sentAt        DateTime? @db.Timestamptz

  @@index([status, nextAttemptAt])
}

// AccountErasure (T-4805) — заявка на стирання PII (GDPR). phoneHash замість
// номера: аудит не тримає plaintext. subjectId унікальний — одна заявка на
// акаунт; повторне звернення перевідкриває її. report — комплаєнс-знімок.
model AccountErasure {
  id            String    @id @db.Uuid
  subjectId     String    @unique @db.Uuid
  phoneHash     String
  status        String    @default("pending")
  attempts      Int       @default(0)
  requestedAt   DateTime  @default(now()) @db.Timestamptz
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz
  completedAt   DateTime? @db.Timestamptz
  lastError     String?
  report        Json?

  @@index([status, nextAttemptAt])
}

// IdempotencyRecord (T-4207) — кеш відповідей на `Idempotency-Key` (UUID v4,
// TTL 24 год). key унікальний; responseBody — тіло відповіді для replay, без
// заголовків (Set-Cookie не кешуємо). upsert перезаписує прострочений ключ.
model IdempotencyRecord {
  id           String   @id @db.Uuid
  key          String   @unique
  fingerprint  String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now()) @db.Timestamptz
  expiresAt    DateTime @db.Timestamptz

  @@index([expiresAt])
}

model Product {
  id          String   @id @db.Uuid
  name        String
  description String?
  brand       String?
  category    String?
  photoUrl    String?  // media.fade.com.ua CDN URL
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  variants    ProductVariant[]
}

model ProductVariant {
  id          String   @id @db.Uuid
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String   // volume/color
  sku         String   @unique
  price       Int      // in kopecks
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  stockItems  StockItem[]

  @@index([productId])
}

model StockItem {
  id          String         @id @db.Uuid
  variantId   String         @db.Uuid
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId  String         @db.Uuid
  location    Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity    Int            @default(0)
  createdAt   DateTime       @default(now()) @db.Timestamptz
  updatedAt   DateTime       @updatedAt @db.Timestamptz

  @@unique([variantId, locationId])
  @@index([locationId])
  @@index([variantId])
}
