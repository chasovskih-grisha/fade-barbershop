{
  "name": "@fade/api",
  "private": true,
  "version": "0.0.0",
  "description": "HTTP + realtime API, modular monolith",
  "scripts": {
    "build": "nest build",
    "seed:dev": "ts-node scripts/seed-dev.ts",
    "seed": "ts-node scripts/seed-dev.ts && ts-node src/seed-customers.ts && ts-node scripts/seed-appointments.ts",
    "seed:e2e": "prisma migrate reset --force --skip-seed && FADE_SEED_FIXED_IDS=1 ts-node scripts/seed-dev.ts && ts-node src/seed-admin.ts && ts-node src/seed-customers.ts && FADE_SEED_FIXED_IDS=1 ts-node scripts/seed-appointments.ts",
    "start": "nest start",
    "dev": "node scripts/dev-watch.mjs",
    "dev:webpack": "node scripts/dev-watch.mjs",
    "dev:nest": "nest start --watch --webpack",
    "test:dev-watch": "node --test scripts/dev-watch.test.mjs",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=/e2e/ --passWithNoTests",
    "test:functional": "jest --testPathPattern=e2e\\.spec\\.ts$ --testPathIgnorePatterns='/node_modules/|fresh-bootstrap' --forceExit --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "seed:admin": "ts-node src/seed-admin.ts",
    "seed:admin-roles": "ts-node src/seed-admin-roles.ts",
    "seed:customers": "ts-node src/seed-customers.ts",
    "seed:appointments": "ts-node scripts/seed-appointments.ts",
    "seed:smoke": "pnpm exec prisma migrate reset --force --skip-seed && pnpm exec ts-node scripts/seed-dev.ts && pnpm exec ts-node src/seed-customers.ts && pnpm exec ts-node scripts/seed-appointments.ts && pnpm exec ts-node src/seed-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@fade/contracts": "workspace:*",
    "@fade/design-tokens": "workspace:*",
    "@fade/domain-shared": "workspace:*",
    "@fade/test-utils": "workspace:*",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^6.19.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "ioredis": "^6.0.0",
    "liquidjs": "^10.30.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.1.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "prisma": {
    "seed": "ts-node scripts/seed-dev.ts && ts-node src/seed-customers.ts && ts-node scripts/seed-appointments.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.18",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-nestjs": "^1.2.3",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "pg": "^8.16.0",
    "pg-hstore": "^2.3.4",
    "postcss": "^8.5.23",
    "prettier": "^3.0.0",
    "prisma": "6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
