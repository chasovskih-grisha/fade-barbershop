{% if rows.size > 0 %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;margin:{{ email.spacing }} 0;background-color:{{ email.bg }};border:1px solid {{ email.border }};border-radius:{{ email.radius }};">
  <tr>
    <td style="padding:4px {{ email.spacing }};">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
        {% for row in rows %}
        <tr>
          <td style="padding:10px 12px 10px 0;border-bottom:{% if forloop.last %}none{% else %}1px solid {{ email.border }}{% endif %};width:36%;font-family:{{ email.fontStack }};font-size:{{ email.fontSizeCaption }};line-height:1.4;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:{{ email.textSecondary }};vertical-align:middle;">{{ row.label }}</td>
          <td style="padding:10px 0;border-bottom:{% if forloop.last %}none{% else %}1px solid {{ email.border }}{% endif %};font-family:{{ email.fontStack }};font-size:{{ email.fontSizeBody }};line-height:1.4;font-weight:600;color:{{ email.textPrimary }};vertical-align:middle;">{{ row.value }}</td>
        </tr>
        {% endfor %}
      </table>
    </td>
  </tr>
</table>
{% endif %}
