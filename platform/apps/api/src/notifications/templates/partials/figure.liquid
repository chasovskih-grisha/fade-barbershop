{% if value != blank %}
<p style="margin:0 0 4px;font-family:{{ email.fontStack }};font-size:{{ email.fontSizeCaption }};line-height:1.2;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:{{ email.textSecondary }};">{{ caption }}</p>
<p style="margin:0 0 {{ email.spacing }};font-family:{{ email.fontStack }};font-size:{{ email.fontSizeFigure }};line-height:1.2;font-weight:700;color:{{ email.textPrimary }};">{{ value }}</p>
{% endif %}
