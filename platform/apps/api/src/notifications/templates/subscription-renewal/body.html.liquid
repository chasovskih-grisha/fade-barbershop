{% layout "layouts/letter.liquid" %}
{% assign title = "Підписку оновлено" %}
{% assign preheader = "Ваш абонемент успішно оновлено." %}
{% assign footer = brand | append: " Barbershop • Підписки" %}
{% block content %}
{% render "partials/text", lead: "Вітаємо, " | append: client_name | append: "! Ваш абонемент/підписку у мережі барбершопів успішно оновлено." %}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:{{ email.bg }};border:1px solid {{ email.border }};border-radius:{{ email.radius }};margin:{{ email.spacing }} 0;border-collapse:collapse;">
  <tr>
    <td style="padding:{{ email.spacing }};">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
        <tr>
          <td style="padding-bottom:10px;font-family:{{ email.fontStack }};font-size:{{ email.fontSizeCaption }};color:{{ email.textSecondary }};">Тип підписки:</td>
          <td align="right" style="padding-bottom:10px;font-family:{{ email.fontStack }};font-size:{{ email.fontSizeCaption }};font-weight:700;color:{{ email.textPrimary }};">{{ subscription_name }}</td>
        </tr>
        <tr>
          <td style="padding-bottom:10px;font-family:{{ email.fontStack }};font-size:{{ email.fontSizeCaption }};color:{{ email.textSecondary }};">Діє до:</td>
          <td align="right" style="padding-bottom:10px;font-family:{{ email.fontStack }};font-size:{{ email.fontSizeCaption }};font-weight:700;color:{{ email.textPrimary }};">{{ expiry_date }}</td>
        </tr>
        <tr>
          <td style="font-family:{{ email.fontStack }};font-size:{{ email.fontSizeCaption }};color:{{ email.textSecondary }};">Сума оплати:</td>
          <td align="right" style="font-family:{{ email.fontStack }};font-size:{{ email.fontSizeCaption }};font-weight:700;color:{{ email.textPrimary }};">{{ amount }}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>

{% render "partials/text", lead: "Дякуємо, що залишаєтесь із нами! Чекаємо на вас у наших салонах." %}
{% render "partials/button", url: dashboard_url, label: "Керувати підпискою" %}
{% endblock %}
