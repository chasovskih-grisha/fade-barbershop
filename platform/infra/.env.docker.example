# Copy to .env.docker (same folder) before `docker compose up`. Never commit secrets.
# Loaded via: docker compose --env-file infra/.env.docker up -d
#
# Container-internal hostnames (postgres / redis / minio) are fixed by the
# compose service names — app code inside the network always uses those.
# Containers are named fade-platform-* and use the fade-platform-net network.
#
# Host ports are non-standard and bound to 127.0.0.1 only (loopback), so the
# stack never collides with a local Postgres/Redis/MinIO or another project:
# - Postgres: 15432 (non-standard to avoid conflict with local Postgres)
# - Redis: 16379 (non-standard to avoid conflict with local Redis)
# - MinIO API: 19000 (non-standard to avoid conflict with other services)
# - MinIO Console: 19001 (non-standard for web UI)

# -- Postgres -----------------------------------------------------------------
POSTGRES_USER=barbershop
POSTGRES_PASSWORD=barbershop
POSTGRES_DB=barbershop
POSTGRES_PORT=15432

# -- Redis --------------------------------------------------------------------
REDIS_PORT=16379

# -- MinIO (S3-compatible object storage, future media.fade.ua) ----------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# -- S3 client config for apps running INSIDE the compose network -------------
# (host-side tools use http://localhost:19000 instead — see .env.example)
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:19000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# -- API -----------------------------------------------------------------------
# CORS allowlist for browser callers (ADR 0017). Dev origins are the host-accessed
# web/admin; production values are set with the deploy env. Never use '*'.
CORS_ALLOWED_ORIGINS=http://localhost:13001,http://localhost:13002

# -- Buckets (created idempotently by minio-init on every `up`) ----------------
# S3_BUCKET_AI=haircut-ai-photos      (ADR 0008 — private, retention 12m)
# S3_BUCKET_FEEDBACK=feedback-photos  (ADR 0015 — private, lifecycle = feedback)
# S3_BUCKET_MEDIA=media               (shop + gallery public assets, CDN later)
