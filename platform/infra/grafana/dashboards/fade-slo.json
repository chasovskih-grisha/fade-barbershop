{
  "title": "Fade — SLO та error budget",
  "uid": "fade-slo",
  "tags": ["fade", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Availability SLO 99.5% / 28d (good = відповідь без 5xx; docs/slo.md)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error budget — залишок (28d)",
      "description": "1 − спалений бюджет. 100% = свіжий період; ≤0% = SLO зламано. Budget = 0.5% 5xx за 28 днів.",
      "datasource": { "type": "prometheus", "uid": "prometheus-fade" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": -0.5,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0 },
              { "color": "green", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - ((1 - (sum(increase(fade_http_requests_total{code!~\"5xx\"}[28d])) / sum(increase(fade_http_requests_total[28d])))) / 0.005)",
          "legendFormat": "budget left"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Availability SLI (28d rolling, SLO 99.5%)",
      "datasource": { "type": "prometheus", "uid": "prometheus-fade" },
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.9,
          "max": 1,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.995 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(fade_http_requests_total{code!~\"5xx\"}[28d])) / sum(increase(fade_http_requests_total[28d]))",
          "legendFormat": "availability"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Burn rate (1h, 6h) — ліві вертикалі: 14.4× / 6×",
      "description": "Швидке спалення (1h) ≥14.4× → критичний алерт AvailabilityBurnRateFast; повільне (6h) ≥6× → warning. 1.0 = бюджет «за розкладом».",
      "datasource": { "type": "prometheus", "uid": "prometheus-fade" },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - (sum(rate(fade_http_requests_total{code!~\"5xx\"}[1h])) / sum(rate(fade_http_requests_total[1h])))) / 0.005 * (28 * 24 / 1)",
          "legendFormat": "burn 1h"
        },
        {
          "refId": "B",
          "expr": "(1 - (sum(rate(fade_http_requests_total{code!~\"5xx\"}[6h])) / sum(rate(fade_http_requests_total[6h])))) / 0.005 * (28 * 24 / 6)",
          "legendFormat": "burn 6h"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Booking latency SLO 95% / 28d (good = /booking-запит швидше за 500мс; docs/slo.md)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Error budget — залишок (28d)",
      "description": "Budget = 5% повільних (≥500мс) /booking-запитів за 28 днів.",
      "datasource": { "type": "prometheus", "uid": "prometheus-fade" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": -0.5,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0 },
              { "color": "green", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - ((1 - (1 - (sum(increase(fade_http_booking_slow_total[28d])) / sum(increase(fade_http_requests_total{route=\"booking\"}[28d]))))) / 0.05)",
          "legendFormat": "budget left"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Booking latency SLI (28d rolling, SLO 95%)",
      "datasource": { "type": "prometheus", "uid": "prometheus-fade" },
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.5,
          "max": 1,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(increase(fade_http_booking_slow_total[28d])) / sum(increase(fade_http_requests_total{route=\"booking\"}[28d])))",
          "legendFormat": "fast ratio"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Burn rate (1h, 6h) — ліві вертикалі: 14.4× / 6×",
      "datasource": { "type": "prometheus", "uid": "prometheus-fade" },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(fade_http_booking_slow_total[1h]) / rate(fade_http_requests_total{route=\"booking\"}[1h])) / 0.05 * (28 * 24 / 1)",
          "legendFormat": "burn 1h"
        },
        {
          "refId": "B",
          "expr": "(rate(fade_http_booking_slow_total[6h]) / rate(fade_http_requests_total{route=\"booking\"}[6h])) / 0.05 * (28 * 24 / 6)",
          "legendFormat": "burn 6h"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Обсяг трафіку (SLI без трафіку = 100% good, але рішення приймає людина)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Запити за хвилину (route × статус-клас)",
      "datasource": { "type": "prometheus", "uid": "prometheus-fade" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, code) (rate(fade_http_requests_total[5m])) * 60",
          "legendFormat": "{{route}} {{code}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Повільні /booking-запити (≥500мс) на хвилину",
      "datasource": { "type": "prometheus", "uid": "prometheus-fade" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(fade_http_booking_slow_total[5m]) * 60",
          "legendFormat": "slow"
        }
      ]
    }
  ]
}
