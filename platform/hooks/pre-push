#!/bin/sh
# Refuse a push to stage that marks a task review or done without the gate's evidence.
set -eu
root=$(git rev-parse --show-toplevel)
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/stage" ] || continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    echo "agent-gate: refusing a new branch" >&2
    exit 1
  fi
  node "$root/scripts/agent-gate.mjs" verify-range --from "$remote_sha" --to "$local_sha"
done
exit 0
